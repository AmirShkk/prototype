
---
import StandardLayout from '@/layouts/StandardLayout.astro'
import HubLedgerContent from '@/components/hub_ledger/HubLedgerContent'

const userRole = 'hub'
const userName = 'Neha Shah'
const userAvatar = 'https://spark-builder.s3.us-east-1.amazonaws.com/image/2026/9/6/4724825a-2439-475b-8668-4636bb961b21.png'
const currentPath = Astro.url.pathname
---

<StandardLayout 
  title="Hub Ledger - FarmHub Connect" 
  userRole={userRole}
  userName={userName}
  userAvatar={userAvatar}
  currentPath={currentPath}
>
  <HubLedgerContent client:load />
</StandardLayout>
