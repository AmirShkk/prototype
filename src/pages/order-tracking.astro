
---
import StandardLayout from '@/layouts/StandardLayout.astro';
import OrderTrackingContent from '@/components/order_tracking/OrderTrackingContent';

const currentPath = Astro.url.pathname;
---

<StandardLayout 
  title="Order Tracking"
  userRole="consumer"
  userName="Ananya Roy"
  userAvatar="https://spark-builder.s3.us-east-1.amazonaws.com/image/2026/9/6/34f3115a-ee53-4b16-9931-b4c23479c5ee.png"
  cartCount={2}
>
  <OrderTrackingContent client:load currentPath={currentPath} />
</StandardLayout>
